        <attribute name="edited" value="REFWSURFQVJBVUpPTU9VUkFEQVM7REYwMS1MQUIwOC0xODsyMDI2LTA4LTIxOyIxMDozOToyMyAiOzM7REFWSURFQVJBVUpPTU9VUkFEQVM7REYwMS1MQUIwOC0xODsyMDI2LTA4LTIxOyIwODozMToxMiAiOzcwMDI="/>
        <attribute name="edited" value="REFWSURFQVJBVUpPTU9VUkFEQVM7REYwMS1MQUIwOC0xODsyMDI2LTA4LTIxOyIxMTowMzo1NyAiOzI7MzUyNg=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="opcao" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite 1 para soma, 2 para subtra&#231;&#227;o, 3 para multiplica&#231;&#227;o, 4 para divis&#227;o, 5 para logar&#237;tmo na base 10, 6 para logaritmo, 7 para ra&#237;z quadrada, 8 para tangente,9 para arcoseno trigonom&#233;trico,10 para valor integral,11 para valor absoluto, 12 para logaritmo natural, 13 para express&#227;o, 14 para exponente, 15 para fun&#231;&#227;o, 16 para concatena&#231;&#227;o de strings&quot;" newline="True"/>
            <input variable="opcao"/>
            <if expression="opcao == 1">
                <then>
                    <declare name="a, b, c" type="Real" array="False" size=""/>
                    <output expression="&quot;Digite o valor de a:&quot;" newline="True"/>
                    <input variable="a"/>
                    <output expression="&quot;Digite o valor de b:&quot;" newline="True"/>
                    <input variable="b"/>
                    <assign variable="c" expression="a + b"/>
                    <output expression="&quot;o valor da express&#227;o &#233;:&quot;&amp;c" newline="True"/>
                </then>
                <else>
                    <if expression="opcao == 2">
                        <then>
                            <declare name="a, b, c" type="Real" array="False" size=""/>
                            <output expression="&quot;Digite o valor de a:&quot;" newline="True"/>
                            <input variable="a"/>
                            <output expression="&quot;Digite o valor de b:&quot;" newline="True"/>
                            <input variable="b"/>
                            <assign variable="c" expression="a - b"/>
                            <output expression="&quot;o valor da express&#227;o &#233;:&quot;&amp;c" newline="True"/>
                        </then>
                        <else>
                            <if expression="opcao == 3">
                                <then>
                                    <declare name="a, b, c" type="Real" array="False" size=""/>
                                    <output expression="&quot;Digite o valor de a:&quot;" newline="True"/>
                                    <input variable="a"/>
                                    <output expression="&quot;Digite o valor de b:&quot;" newline="True"/>
                                    <input variable="b"/>
                                    <assign variable="c" expression="a * b"/>
                                    <output expression="&quot;o valor da express&#227;o &#233;:&quot;&amp;c" newline="True"/>
                                </then>
                                <else>
                                    <if expression="opcao == 4">
                                        <then>
                                            <declare name="a, b, c" type="Real" array="False" size=""/>
                                            <output expression="&quot;Digite o valor de a:&quot;" newline="True"/>
                                            <input variable="a"/>
                                            <output expression="&quot;Digite o valor de b:&quot;" newline="True"/>
                                            <input variable="b"/>
                                            <assign variable="c" expression="a / b"/>
                                            <output expression="&quot;o valor da express&#227;o &#233;:&quot;&amp;c" newline="True"/>
                                        </then>
                                        <else>
                                            <if expression="opcao == 5">
                                                <then>
                                                    <declare name="a, b" type="Real" array="False" size=""/>
                                                    <output expression="&quot;Digite o valor de a:&quot;" newline="True"/>
                                                    <input variable="a"/>
                                                    <assign variable="b" expression="Log10(a)"/>
                                                    <output expression="&quot;o valor da express&#227;o &#233;:&quot;&amp;b" newline="True"/>
                                                </then>
                                                <else>
                                                    <if expression="opcao == 6">
                                                        <then>
                                                            <declare name="a, b" type="Real" array="False" size=""/>
                                                            <output expression="&quot;Digite o valor de a:&quot;" newline="True"/>
                                                            <input variable="a"/>
                                                            <assign variable="b" expression="Log(a)"/>
                                                            <output expression="&quot;o valor da express&#227;o &#233;:&quot;&amp;b" newline="True"/>
                                                        </then>
                                                        <else>
                                                            <if expression="opcao == 7">
                                                                <then>
                                                                    <declare name="a, b" type="Real" array="False" size=""/>
                                                                    <output expression="&quot;Digite o valor de a:&quot;" newline="True"/>
                                                                    <input variable="a"/>
                                                                    <assign variable="b" expression="Sqrt(a)"/>
                                                                    <output expression="&quot;o valor da express&#227;o &#233;:&quot;&amp;b" newline="True"/>
                                                                </then>
                                                                <else>
                                                                    <if expression="opcao == 8">
                                                                        <then>
                                                                            <declare name="a, b" type="Real" array="False" size=""/>
                                                                            <output expression="&quot;Digite o valor de a:&quot;" newline="True"/>
                                                                            <input variable="a"/>
                                                                            <assign variable="b" expression="Tan(a)"/>
                                                                            <output expression="&quot;o valor da express&#227;o &#233;:&quot;&amp;b" newline="True"/>
                                                                        </then>
                                                                        <else>
                                                                            <if expression="opcao == 9">
                                                                                <then>
                                                                                    <declare name="b, c" type="Real" array="False" size=""/>
                                                                                    <output expression="&quot;Digite o valor de b:&quot;" newline="True"/>
                                                                                    <input variable="b"/>
                                                                                    <assign variable="c" expression="Abs(b)"/>
                                                                                    <output expression="&quot;o valor da express&#227;o &#233;:&quot;&amp;c" newline="True"/>
                                                                                </then>
                                                                                <else>
                                                                                    <if expression="opcao == 10">
                                                                                        <then>
                                                                                            <declare name="a, b" type="Real" array="False" size=""/>
                                                                                            <output expression="&quot;Digite o valor de a:&quot;" newline="True"/>
                                                                                            <input variable="a"/>
                                                                                            <assign variable="b" expression="Int(a)"/>
                                                                                            <output expression="&quot;o valor da express&#227;o &#233;:&quot;&amp;b" newline="True"/>
                                                                                        </then>
                                                                                        <else>
                                                                                            <if expression="opcao == 11">
                                                                                                <then>
                                                                                                    <declare name="a, b" type="Real" array="False" size=""/>
                                                                                                    <output expression="&quot;Digite o valor de a:&quot;" newline="True"/>
                                                                                                    <input variable="a"/>
                                                                                                    <assign variable="b" expression="Abs(a)"/>
                                                                                                    <output expression="&quot;o valor da express&#227;o &#233;:&quot;&amp;b" newline="True"/>
                                                                                                </then>
                                                                                                <else>
                                                                                                    <if expression="opcao == 12">
                                                                                                        <then>
                                                                                                            <declare name="a, b" type="Real" array="False" size=""/>
                                                                                                            <output expression="&quot;Digite o valor de a:&quot;" newline="True"/>
                                                                                                            <input variable="a"/>
                                                                                                            <assign variable="b" expression="Ln(a)"/>
                                                                                                            <output expression="&quot;o valor da express&#227;o &#233;:&quot;&amp;b" newline="True"/>
                                                                                                        </then>
                                                                                                        <else>
                                                                                                            <if expression="opcao == 13">
                                                                                                                <then>
                                                                                                                    <declare name="a, b, c, d" type="Real" array="False" size=""/>
                                                                                                                    <output expression="&quot;Digite o valor de a:&quot;" newline="True"/>
                                                                                                                    <input variable="a"/>
                                                                                                                    <assign variable="c" expression="a + d ^ b"/>
                                                                                                                    <output expression="&quot;o valor da express&#227;o &#233;:&quot;&amp;b" newline="True"/>
                                                                                                                </then>
                                                                                                                <else>
                                                                                                                    <if expression="opcao == 14">
                                                                                                                        <then>
                                                                                                                            <declare name="a, b, c" type="Real" array="False" size=""/>
                                                                                                                            <output expression="&quot;Digite o valor de a&quot;" newline="True"/>
                                                                                                                            <input variable="a"/>
                                                                                                                            <output expression="&quot;Digite o valor de b&quot;" newline="True"/>
                                                                                                                            <input variable="b"/>
                                                                                                                            <assign variable="c" expression="a ^ b"/>
                                                                                                                        </then>
                                                                                                                        <else>
                                                                                                                            <if expression="opcao == 15">
                                                                                                                                <then>
                                                                                                                                    <declare name="a, b, c" type="Real" array="False" size=""/>
                                                                                                                                    <output expression="&quot;Digite o valor de a&quot;" newline="True"/>
                                                                                                                                    <input variable="a"/>
                                                                                                                                    <assign variable="c" expression="EOF()"/>
                                                                                                                                </then>
                                                                                                                                <else>
                                                                                                                                    <if expression="opcao == 16">
                                                                                                                                        <then>
                                                                                                                                            <assign variable="mensagem" expression="&quot;o resultado final &#233;: &quot;&amp;resultado"/>
                                                                                                                                            <output expression="mensagem" newline="True"/>
                                                                                                                                        </then>
                                                                                                                                        <else/>
                                                                                                                                    </if>
                                                                                                                                </else>
                                                                                                                            </if>
                                                                                                                        </else>
                                                                                                                    </if>
                                                                                                                </else>
                                                                                                            </if>
                                                                                                        </else>
                                                                                                    </if>
                                                                                                </else>
                                                                                            </if>
                                                                                        </else>
                                                                                    </if>
                                                                                </else>
                                                                            </if>
                                                                        </else>
                                                                    </if>
                                                                </else>
                                                            </if>
                                                        </else>
                                                    </if>
                                                </else>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
